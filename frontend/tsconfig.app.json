{
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
		"target": "ES2023",
		"useDefineForClassFields": true,
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"types": ["vite/client"],
		"skipLibCheck": true,

		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"noEmit": true,
		"jsx": "react-jsx",

		/* Linting */
		"strict": true,
		"noUnusedLocals": false,
		"noUnusedParameters": true,
		"erasableSyntaxOnly": false,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true,

		/* Alias paths */
		"baseUrl": "./src",
		"paths": {
			// Root
			"@/*": ["./*"],

			// Pages
			"@pages": ["pages/index"],
			"@pages/*": ["pages/*"],

			// Shared
			"@base": ["shared/base/index"],
			"@base/*": ["shared/base/*"],

			"@api": ["shared/api/index"],
			"@api/*": ["shared/api/*"],

			"@ui": ["shared/components/ui/index"],
			"@ui/*": ["shared/components/ui/*"],

			"@common": ["shared/components/common/index"],
			"@common/*": ["shared/components/common/*"],

			"@hooks": ["shared/hooks/index"],
			"@hooks/*": ["shared/hooks/*"],

			"@utils": ["shared/utils/index"],
			"@utils/*": ["shared/utils/*"],

			"@routes": ["shared/routes/index"],
			"@routes/*": ["shared/routes/*"],

			"@sharedTypes": ["shared/types/index"],
			"@sharedTypes/*": ["shared/types/*"],

			// Features
			"@auth": ["features/auth/index"],
			"@auth/*": ["features/auth/*"],

			"@products": ["features/products/index"],
			"@products/*": ["features/products/*"],

			"@categories": ["features/categories/index"],
			"@categories/*": ["features/categories/*"],

			// Store
			"@store": ["store/index"],
			"@store/*": ["store/*"]
		}
	},
	"include": ["src"]
}
